# Copia este archivo a .env y completa los valores. Nunca subas el .env real.

# RabbitMQ local
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme

# Equipo (EQUIPO_A, EQUIPO_B, EQUIPO_C o EQUIPO_D): debe coincidir con la API key
TEAM_CODE=EQUIPO_A

# Replica de solo lectura de oficina-agua-infra (el producer lee los pagos de aqui)
# Dentro de Docker Compose: host db-replica, puerto 3306
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=3307
DB_NAME=oficina_agua
DB_LECTURA_USER=
DB_LECTURA_PASSWORD=

# DynamoDB Local (control y logs de pagos). Dentro de Docker: http://dynamodb-pagos:8000
DYNAMODB_ENDPOINT=http://localhost:8012
DYNAMODB_TABLE_CONTROL=pagos-control
DYNAMODB_TABLE_LOGS=pagos-logs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Simuladores del docente (las URLs y las llaves las entrega el docente)
BANK_BASE_URL=https://REEMPLAZAR_API_ID.execute-api.us-east-1.amazonaws.com/prod
BANK_API_KEY=
ERP_BASE_URL=https://REEMPLAZAR_API_ID.execute-api.us-east-1.amazonaws.com/prod
ERP_API_KEY=
