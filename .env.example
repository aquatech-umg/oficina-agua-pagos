# Copiar a .env y llenar los valores. El .env NO se sube a Git.
# Lo leen el docker compose (RabbitMQ) y los dos servicios al arrancar (spring.config.import).
# No dejar vacía una variable que tiene valor por defecto: un valor vacío le gana al defecto.

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme

TEAM_CODE=EQUIPO_A
# Prefijo de la llave de idempotencia (los simuladores son compartidos por todos los grupos).
# No se cambia después de enviar pagos: con otro prefijo el destino los toma como pagos distintos.
PAGOS_EQUIPO=EQA-AQT
# El producer solo envía pagos con fecha_pago desde este día (sin esto mandaría los ~37 mil pagos)
PAGOS_DESDE=2026-09-19

DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=3307
DB_REPLICA_NAME=oficina_agua
DB_LECTURA_USER=lectura
# La clave de lectura definida en oficina-agua-infra/.env
DB_LECTURA_PASSWORD=

DYNAMODB_ENDPOINT=http://localhost:8012
DYNAMODB_TABLE_CONTROL=pagos-control
DYNAMODB_TABLE_LOGS=pagos-logs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

BANK_BASE_URL=https://gdsi5lyj34.execute-api.us-east-1.amazonaws.com/prod
ERP_BASE_URL=https://gdsi5lyj34.execute-api.us-east-1.amazonaws.com/prod

# Llave x-api-key entregada por el docente
BANK_API_KEY=
ERP_API_KEY=
SIMULADOR_USUARIO=
SIMULADOR_PASSWORD=

# Solo pruebas (AQ-142): fuerza un escenario del simulador. Vacío = comportamiento normal.
BANK_SIMULATION_SCENARIO=
ERP_SIMULATION_SCENARIO=